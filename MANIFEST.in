include LICENSE AUTHORS.md WEIGHTS_LICENSE.txt THIRD_PARTY_NOTICES.txt UPSTREAM.md
include README.md README.zh-CN.md requirements.txt
recursive-include wapr/ogl_native *.cpp *.h *.cu *.cuh *.vert *.frag CMakeLists.txt LICENSE*
recursive-include wapr/fonts *
recursive-include wapr/weight_license *
recursive-include wapr/runtime_assets *
recursive-include configs *.json
recursive-include docs *.md
prune .venv
prune .wapr_runtime
prune outputs
global-exclude __pycache__ *.py[cod] *.engine *.onnx *.pth *.so
